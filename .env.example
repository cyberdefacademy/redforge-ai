# REDFORGE AI Environment — copy to .env, then generate real secrets.
# Generate: openssl rand -hex 32
POSTGRES_DB=redforge
POSTGRES_USER=redforge
POSTGRES_PASSWORD=CHANGE_ME_32_PLUS_CHARS
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://redforge:CHANGE_ME@db:5432/redforge

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_32_PLUS_CHARS

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

MCP_KALI_URL=http://kali-mcp:3001
OLLAMA_URL=http://ollama:11434
AI_PROVIDER=ollama
ENABLE_EXTERNAL_LLM=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
PROVIDER_DEFAULT=ollama-local
CLOUD_DEFAULT_MODEL=gpt-4o-mini
AI_MODEL_LOCAL=llama3.1
AI_MODEL_EXTERNAL=gpt-4o-mini

EVIDENCE_DIR=/var/lib/redforge/evidence
SEED_ADMIN_EMAIL=admin@redforge.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ON_BOOT=true

# Ports (compose): dev API 8088 / frontend 3088; prod API 8000 / frontend 80
API_PORT=8088
FRONTEND_PORT=3088
REDIS_PORT=6399
FRONTEND_URL=http://localhost:3088
VITE_API_URL=
API_URL=http://localhost:8088

ENV=development
LOG_LEVEL=INFO
UVICORN_WORKERS=2
CORS_ORIGINS=http://localhost:3088,http://localhost:5173
